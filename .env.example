# Database Connection
# Replace with your actual PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:6543/hackx_jr_registration?pgbouncer=true"
DIRECT_URL="postgresql://username:password@localhost:5432/hackx_jr_registration"

# Auth & Session Secrets
# Generate random 32-character strings for these secrets (e.g. openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here-at-least-32-chars"
SESSION_SECRET="your-session-secret-here-at-least-32-chars"

# Cloudflare Turnstile
# For local testing, you can use Cloudflare's dummy test keys:
# Site Key: 1x00000000000000000000AA (always passes without widget display)
# Secret Key: 2x00000000000000000000000000000000AB (always passes verification)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="2x00000000000000000000000000000000AB"

# Initial Super Admin Credentials
# These will be seeded into the database on startup/seed run
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD="ChooseAStrongPassword123!"

# Application Settings
APP_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="info"
